# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use a hex password here so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=
# Local pilot; open exactly http://localhost:8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ENVIRONMENT=development
# For Internet hosting: set the three values above to https://your-domain,
# true, production; set DOMAIN to that DNS name, without https://.
DOMAIN=localhost
