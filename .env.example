# Copy to .env (never commit .env). Generate distinct long random secrets.
POSTGRES_USER=danaya
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=danaya_db
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# URL encode special characters in DB password before placing in DATABASE_URL.
DATABASE_URL=postgresql://danaya:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@postgres:5432/danaya_db
ENVIRONMENT=development
# API traffic should go through the same-origin reverse proxy.
REACT_APP_API_URL=/api/auth
REACT_APP_PATIENT_API_URL=/api/patients
REACT_APP_REGISTRY_API_URL=/api/registry
